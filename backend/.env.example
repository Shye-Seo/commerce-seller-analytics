# ---------------------------------------------------------------------------
# SellerScope 백엔드 환경 변수 (.env.example → .env 로 복사)
# 실제 키는 절대 커밋하지 않는다. .gitignore 에 .env 가 포함되어 있다.
# ---------------------------------------------------------------------------

APP_ENV=local
APP_DEBUG=true

# MySQL 8.0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sellerscope
DB_USERNAME=sellerscope
DB_PASSWORD=change-me
# 소켓으로 붙을 때만 사용(예: /tmp/mysqld.sock). 비우면 TCP로 접속한다.
DB_UNIX_SOCKET=
DB_TIMEZONE=+09:00

# 네이버클라우드 플랫폼 SENS (카카오 알림톡)
# 콘솔 > Simple & Easy Notification Service > 프로젝트 > 서비스 ID
SENS_ACCESS_KEY=
SENS_SECRET_KEY=
SENS_SERVICE_ID=
SENS_PLUS_FRIEND_ID=@sellerscope
SENS_TEMPLATE_ANOMALY=SS_ANOMALY_CRITICAL
SENS_TEMPLATE_SUMMARY=SS_BATCH_SUMMARY
# SMS 대체 발송을 쓰려면 콘솔에 등록한 발신번호를 넣는다(미설정이면 알림톡만)
SENS_FAILOVER_FROM=
SENS_BASE_URL=https://sens.apigw.ntruss.com
